# 1) 忽略根目录一切
/*

# 2) 放行 src
!/src/
!/src/**

# 3) 放行构建必需文件
!/build.gradle
!/settings.gradle
!/gradle.properties
!/gradlew
!/gradlew.bat
!/gradle/
!/gradle/wrapper/
!/gradle/wrapper/gradle-wrapper.jar
!/gradle/wrapper/gradle-wrapper.properties

# 4) 放行协作/规范文件
!/.gitignore
!/.gitattributes
!/README.md
!/.github/
!/.github/**

# 5) 按需取消注释
!/LICENSE.txt
!/LICENSE

# 6) src 内部仍排除产物
/src/**/.idea/
/src/**/*.iml
/src/**/out/
/src/**/build/
/src/**/bin/
/src/**/.gradle/
/src/**/.cache/